# Environment configuration for ai-job-recommendation-engine
# Copy this file to .env and fill in sensitive / environment-specific values.

# Application
APP_NAME=ai-job-recommendation-engine
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
POSTGRES_USER=app
POSTGRES_PASSWORD=change_this_in_production_password
POSTGRES_DB=jobs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:change_this_in_production_password@localhost:5432/jobs

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Vector Database & FAISS
VECTOR_BACKEND=faiss
FAISS_INDEX_PATH=data/processed/faiss_index.index
QDRANT_URL=http://localhost:6333

# Models & Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=main
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=50

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=job_recommendation_benchmark

# Rate Limiting & File Uploads
MAX_UPLOAD_MB=10
RATE_LIMIT=60/minute

# LLM Verbalization (Optional, Off by default)
LLM_ENABLED=false
LLM_PROVIDER=none
LLM_API_KEY=
